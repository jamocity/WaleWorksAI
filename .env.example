# Copy to .env.local. Supabase Dashboard → Project Settings → API → Project URL + Publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Legacy anon key is accepted as a fallback if your project still uses it.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Use only in trusted server-only code. Never prefix the service role key with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional Phase 3 AI service configuration. Keep server-only.
# AI_API_KEY=YOUR_PROVIDER_KEY
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini

# Public origin used for portfolio share links after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
