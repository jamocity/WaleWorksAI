# Local development (zero API charge): run Ollama on the same computer as Next.js.
WALEWORKS_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional cloud provider for a deployed Vercel app.
# Leave these unset to keep cloud AI disabled and avoid API usage/charges.
# WALEWORKS_AI_PROVIDER=groq
# GROQ_API_KEY=your_server_side_key
# GROQ_MODEL=openai/gpt-oss-20b
